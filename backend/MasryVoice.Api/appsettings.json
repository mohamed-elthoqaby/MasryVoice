{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=masryvoice.db",
    "PostgreSql": "Host=localhost;Port=5432;Database=masryvoice_db;Username=masryvoice;Password=YOUR_POSTGRES_PASSWORD_HERE"
  },
  "Security": {
    "AdminKey": "YOUR_ADMIN_SECRET_KEY_HERE",
    "HmacSecret": "YOUR_HMAC_SECRET_KEY_HERE"
  },
  "LlmProvider": "Ollama",
  "Ollama": {
    "BaseUrl": "http://127.0.0.1:11434",
    "DefaultModel": "qwen2.5:3b"
  },
  "Inference": {
    "MaxConcurrency": 1,
    "MaxQueueLength": 5,
    "QueueWaitTimeoutSeconds": 15
  },
  "Voice": {
    "SttProvider": "LocalEgyptianVoice",
    "TtsProvider": "LocalEgyptianVoice",
    "SpeechServerUrl": "http://127.0.0.1:8000",
    "MaxConcurrentStt": 2,
    "MaxConcurrentTts": 2,
    "MaxQueueLength": 5,
    "QueueWaitTimeoutSeconds": 15
  },
  "Telephony": {
    "AudioSocketPort": 9092
  },
  "Integrations": {
    "ProviderMode": "Mock",
    "Microsoft365": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": "",
      "UserPrincipalName": "doctor@clinic.masryvoice.eg"
    },
    "WhatsApp": {
      "PhoneNumberId": "",
      "AccessToken": "",
      "AppSecret": "",
      "VerifyToken": "masryvoice_webhook_token"
    },
    "Telegram": {
      "BotToken": "",
      "ClinicStaffChatId": 0,
      "WebhookSecretToken": ""
    }
  }
}

