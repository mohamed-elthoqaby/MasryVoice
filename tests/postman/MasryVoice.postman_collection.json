          "name": "Confirm Pending Booking - Explicit Customer Action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{currentConversationId}}\",\n  \"pendingBookingId\": \"{{stagedPendingBookingId}}\",\n  \"expectedRequestHash\": \"{{stagedRequestHash}}\"\n}"
