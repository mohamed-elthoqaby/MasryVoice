    {
      "name": "04_Booking_Lifecycle_And_Trust_Boundary",
      "item": [
        {
          "name": "Stage Pending Booking Draft",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate isolated conversation GUID and random test customer phone",
                  "var convId = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                  "    return v.toString(16);",
                  "});",
                  "var randPhone = '010' + Math.floor(10000000 + Math.random() * 90000000);",
                  "pm.environment.set('currentConversationId', convId);",
                  "pm.environment.set('currentCustomerPhone', randPhone);",
                  "pm.environment.set('currentCustomerName', 'محمد أحمد عاطف');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pending booking staged with 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.status).to.eql('Pending');",
                  "    pm.expect(res.pendingBookingId).to.be.a('string');",
                  "    pm.expect(res.requestHash).to.be.a('string');",
                  "    pm.environment.set('stagedPendingBookingId', res.pendingBookingId);",
                  "    pm.environment.set('stagedRequestHash', res.requestHash);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{currentConversationId}}\",\n  \"customerName\": \"{{currentCustomerName}}\",\n  \"customerPhone\": \"{{currentCustomerPhone}}\",\n  \"slotId\": \"{{selectedSlotId}}\",\n  \"serviceName\": \"{{selectedServiceName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/stage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "stage"
              ]
            }
          }
        },
        {
          "name": "Verify Pending Booking In Pending List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/pending?conversationId={{currentConversationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "pending"
              ],
              "query": [
                {
                  "key": "conversationId",
                  "value": "{{currentConversationId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pending booking is listed in database', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var list = pm.response.json();",
                  "    pm.expect(list).to.be.an('array');",
                  "    var item = list.find(function(p) { return p.id === pm.environment.get('stagedPendingBookingId'); });",
                  "    pm.expect(item).to.not.be.undefined;",
                  "    pm.expect(item.status).to.eql('Pending');",
                  "});"
                ]
              }
            }
          ]
        },
