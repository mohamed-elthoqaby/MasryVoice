    {
      "name": "01_System_Health_And_Observability",
      "item": [
        {
          "name": "Health Check - System Status & Cairo Time",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('System reports Healthy and Database connected', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('Healthy');",
                  "    pm.expect(json.databaseConnected).to.be.true;",
                  "    pm.expect(json.cairoTime).to.be.a('string');",
                  "    pm.expect(json.businessSchedule).to.include('Cairo');",
                  "    pm.expect(json.telephony.isListening).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
