            "url": {
              "raw": "{{baseUrl}}/api/bookings/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "confirm"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Confirmation commits booking with 200 OK and returns customer token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.customerToken).to.be.a('string');",
                  "    pm.expect(res.data.bookingId).to.be.a('string');",
                  "    pm.environment.set('issuedCustomerToken', res.customerToken);",
                  "    pm.environment.set('committedBookingId', res.data.bookingId);",
                  "});"
                ]
