          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer can retrieve their own booking via token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var b = pm.response.json();",
                  "    pm.expect(b.id).to.eql(pm.environment.get('committedBookingId'));",
                  "    pm.expect(b.customerName).to.eql(pm.environment.get('currentCustomerName'));",
                  "    pm.expect(b.customerPhone).to.eql(pm.environment.get('currentCustomerPhone'));",
                  "    pm.expect(b.status).to.eql('Confirmed');",
                  "});"
                ]
              }
            }
          ]
        },
