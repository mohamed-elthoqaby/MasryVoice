          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Environment sanitized and dynamic customer tokens cleared\", function () {",
                  "    pm.environment.unset(\"issuedCustomerToken\");",
                  "    pm.environment.unset(\"streamCustomerToken\");",
                  "    pm.environment.unset(\"stagedPendingBookingId\");",
                  "    pm.environment.unset(\"stagedRequestHash\");",
