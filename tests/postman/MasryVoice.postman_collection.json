    {
      "name": "06_Conversation_Streaming_And_Persistence",
      "item": [
        {
          "name": "Chat Stream - SSE Token & Session Issuance",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var sConvId = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                  "    return v.toString(16);",
                  "});",
                  "pm.environment.set('streamConversationId', sConvId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Chat stream returns 200 with text/event-stream content type\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/event-stream\");",
                  "    var body = pm.response.text();",
                  "    pm.expect(body).to.include(\"data:\");",
                  "    pm.expect(body).to.include('\"type\":\"session\"');",
                  "    pm.expect(body).to.include('\"type\":\"token\"');",
                  "    pm.expect(body).to.include('\"type\":\"done\"');",
                  "    var match = body.match(/\"customerToken\":\"([^\"]+)\"/);",
                  "    if (match && match[1]) {",
                  "        pm.environment.set(\"streamCustomerToken\", match[1]);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentId\": \"{{agentId}}\",\n  \"conversationId\": \"{{streamConversationId}}\",\n  \"message\": \"السلام عليكم، عايز أعرف المواعيد\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "stream"
              ]
            }
          }
        },
        {
          "name": "Verify Conversation Persisted in Database",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Customer-Token",
                "value": "{{streamCustomerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{streamConversationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{streamConversationId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Conversation history is persisted and retrieved with messages via customer token\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var conv = pm.response.json();",
                  "    pm.expect(conv.id).to.eql(pm.environment.get(\"streamConversationId\"));",
                  "    pm.expect(conv.messages).to.be.an(\"array\");",
                  "    pm.expect(conv.messages.length).to.be.at.least(2);",
                  "    var userMsg = conv.messages.find(function(m) { return m.role === \"user\"; });",
                  "    var assistantMsg = conv.messages.find(function(m) { return m.role === \"assistant\"; });",
                  "    pm.expect(userMsg).to.not.be.undefined;",
                  "    pm.expect(assistantMsg).to.not.be.undefined;",
                  "    pm.expect(userMsg.content).to.include(\"المواعيد\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
