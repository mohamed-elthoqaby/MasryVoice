          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Slots status is 200 and returns array', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var slots = pm.response.json();",
                  "    pm.expect(slots).to.be.an('array');",
                  "    pm.expect(slots.length).to.be.above(0);",
                  "    var availableSlot = slots.find(function(s) { return s.isAvailable === true; });",
